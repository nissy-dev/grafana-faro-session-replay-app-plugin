faro.receiver "demo" {
  server {
    listen_address           = "0.0.0.0"
    listen_port              = 12347
    cors_allowed_origins     = ["http://localhost:4173"]
    max_allowed_payload_size = "10MiB"

    rate_limiting {
      enabled    = true
      rate       = 100
      burst_size = 200
    }
  }

  output {
    logs = [loki.process.faro.receiver]
  }

  extra_log_labels = {
    source = "faro-demo",
  }

  log_format = "json"
}

loki.process "faro" {
  forward_to = [loki.write.default.receiver]

  stage.json {
    expressions = {
      kind = "kind",
    }
  }

  stage.labels {
    values = {
      kind = "kind",
    }
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
